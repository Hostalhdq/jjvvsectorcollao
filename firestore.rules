rules_version = '2';
// Reglas de privacidad de los reportes.
// - Cualquiera puede CREAR un reporte, nadie anónimo puede leerlo.
// - El mapa público solo lee "reportes_publicos" aprobados (sin nombre ni dirección).
// - Solo administradores (custom claim "admin") leen datos personales y aprueban.
service cloud.firestore {
  match /databases/{db}/documents {
    function esAdmin() { return request.auth != null && request.auth.token.admin == true; }

    match /reportes/{id} {
      allow create: if request.resource.data.autoriza == true;
      allow read, update, delete: if esAdmin();
    }

    match /reportes_publicos/{id} {
      allow create: if request.resource.data.aprobado == false
                    && !('nombre' in request.resource.data)
                    && !('direccion' in request.resource.data)
                    && !('telefono' in request.resource.data);
      allow read: if resource.data.aprobado == true || esAdmin();
      allow update, delete: if esAdmin();
    }
  }
}
